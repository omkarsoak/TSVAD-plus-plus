#!/bin/bash
# PBS job: DIHARD3 data preparation.  Submit from ts-vad/prepare/:  qsub -v DIHARD_ROOT=... prepare_job.pbs
#PBS -q normal
#PBS -j oe
#PBS -l select=1:ncpus=16:mem=100gb:ngpus=1
#PBS -N tsvad_prepare
#PBS -l walltime=05:59:00
set -euo pipefail
cd "${PBS_O_WORKDIR:-$(dirname "$0")}"
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate tsvad
./prepare_dihard.sh
